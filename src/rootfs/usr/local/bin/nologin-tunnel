#!/bin/sh

# If a command was requested (via ssh args or SSH_ORIGINAL_COMMAND), reject execution
if [ "$#" -gt 0 ] || [ -n "$SSH_ORIGINAL_COMMAND" ]; then
    if [ -f /etc/nologin.txt ]; then
        cat /etc/nologin.txt >&2
    else
        echo "This account is restricted to SSH port forwarding / tunneling only." >&2
        echo "Interactive shell sessions and command execution are disabled." >&2
    fi
    exit 1
fi

# When establishing a tunnel session without -N, display connection info / MOTD
if [ -f /etc/motd ]; then
    cat /etc/motd
else
    echo "Connected to SSH Tunnel Server. Port forwarding is active."
fi
echo "Interactive shell is disabled. Port forwarding is active. Press Ctrl+C to disconnect."

# Keep session open to maintain port-forwarding tunnels
exec sleep infinity
