#!/bin/sh
###################################################
# Usage: serversideup-create-unprivileged-user [username] [PUID] [PGID]
###################################################
script_name="serversideup-create-unprivileged-user"

############
# Sanity checks
############
if [ $# -ne 3 ]; then
    echo "🛑 ERROR ($script_name): Invalid number of arguments."
    exit 1
fi

############
# Variables
############
username="$1"
PUID="$2"
PGID="$3"

############
# Main
############
# Register custom nologin shell in /etc/shells if not already present
if ! grep -q "^/usr/local/bin/nologin-tunnel" /etc/shells 2>/dev/null; then
    echo "/usr/local/bin/nologin-tunnel" >> /etc/shells
fi

if [ -f /etc/alpine-release ]; then
    # Alpine
    addgroup -g "${PGID}" "${username}" && \
    adduser -u "${PUID}" -G "${username}" -h "/home/${username}" -s /usr/local/bin/nologin-tunnel -D "${username}"
else
    # Debian
    groupadd -g "${PGID}" "${username}" && \
    useradd --no-log-init \
            -m \
            -s /usr/local/bin/nologin-tunnel \
            -d "/home/${username}" \
            -u "${PUID}" \
            -g "${PGID}" \
            "${username}"
fi

# Set a proper password hash that allows SSH key auth but prevents password login
# '*' allows the account to be active but prevents password login
# This works the same way on both Alpine and Debian
usermod -p '*' "${username}"